QWidget#content, QMainWindow, QScrollArea {
    background-color: #101522;
}
QFrame#card {
    background-color: #1b2334;
    border: 1px solid #303a50;
    border-radius: 12px;
}
QLabel, QCheckBox, QMessageBox QPushButton {
    background: transparent;
}
QLabel#title {
    font-size: 28px;
    font-weight: 700;
    color: #f5f6ff;
}
QLabel#sectionTitle {
    font-size: 17px;
    font-weight: 700;
}
QLabel#device {
    color: #abf3df;
    background-color: #1b393a;
    border: 1px solid #315a57;
    border-radius: 10px;
    padding: 5px 10px;
    font-weight: 600;
}
QLabel#muted {
    color: #bcc7dd;
}
QLineEdit, QComboBox, QSpinBox, QListWidget, QPlainTextEdit {
    background-color: #121a2a;
    border: 1px solid #48546b;
    border-radius: 7px;
    padding: 6px 8px;
}
QComboBox QAbstractItemView {
    background-color: #1b2334;
    border: 1px solid #756ac5;
    selection-background-color: #5549a0;
}
QPlainTextEdit {
    font-size: 14px;
    padding: 10px;
}
QPushButton {
    background-color: #222d42;
    border: 1px solid #596780;
    border-radius: 7px;
    color: #ecf1ff;
    font-weight: 600;
    padding: 5px 11px;
    min-height: 23px;
}
QPushButton:hover {
    background-color: #303d55;
    border-color: #8593ae;
}
QPushButton[role="primary"] {
    background-color: #c3b5ff;
    border-color: #c3b5ff;
    color: #211748;
    font-weight: 700;
}
QPushButton[role="primary"]:hover {
    background-color: #ddd2ff;
}
QPushButton[role="export"] {
    background-color: #1b393a;
    border-color: #4d8580;
    color: #b4f5e4;
}
QPushButton[role="export"]:hover {
    background-color: #285052;
}
QPushButton[role="quiet"] {
    background: transparent;
    border-color: transparent;
    color: #bcc7dd;
}
QPushButton[role="quiet"]:hover {
    background-color: #303d55;
    color: #ffffff;
}
QPushButton:focus, QPushButton[role="quiet"]:focus, QPushButton[role="primary"]:focus,
QPushButton[role="export"]:focus, QLineEdit:focus, QComboBox:focus, QListWidget:focus,
QPlainTextEdit:focus, QSpinBox:focus {
    border: 1px solid #ffffff;
}
QCheckBox:focus {
    outline: 1px solid #ffffff;
}
QCheckBox::indicator:unchecked {
    width: 13px;
    height: 13px;
    border: 1px solid #7c8aa6;
    border-radius: 3px;
    background-color: #121a2a;
}
QPushButton:disabled, QPushButton[role]:disabled, QComboBox:disabled, QLineEdit:disabled {
    color: #8995ad;
    background-color: #232c3c;
    border-color: #38445a;
}
QProgressBar {
    background-color: #303a50;
    border: 0;
    border-radius: 2px;
}
QProgressBar::chunk {
    background-color: #ad98ff;
    border-radius: 2px;
}
QScrollBar:vertical {
    background-color: #101522;
    width: 11px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #596780;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
